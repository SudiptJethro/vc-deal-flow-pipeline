{
  "name": "deal-flow-pipeline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create deal-flow-db",
    "db:migrate": "wrangler d1 execute deal-flow-db --file=./schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute deal-flow-db --file=./schema.sql --local",
    "db:seed": "wrangler d1 execute deal-flow-db --file=./seed.sql --remote",
    "db:seed:local": "wrangler d1 execute deal-flow-db --file=./seed.sql --local",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.81.1"
  }
}
